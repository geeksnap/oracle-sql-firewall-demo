# Dependencies & build output
node_modules/
.next/
out/
dist/
# Root build output only — do not ignore app routes like aegis-vault/src/app/api/build/
/build/
coverage/
.turbo/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.sso
**/credentials.sso

# Terraform variable files with real values (keep *.example)
terraform.tfvars
**/terraform.tfvars

# Logs & runtime
logs/
.pids/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & editor
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/settings.json
.vscode/launch.json

# Oracle / local tooling (optional wallet paths)
.wallets/

# Cursor / local agent (do not publish session state)
.cursor/projects/

# Local-only ops notes (may contain hostnames, credentials, internal URLs)
#Document/
