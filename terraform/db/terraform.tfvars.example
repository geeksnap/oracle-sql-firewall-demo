region            = "ap-tokyo-1"
compartment_id    = "ocid1.compartment.oc1..aaaaaaaaEXAMPLE_REPLACE_WITH_YOUR_COMPARTMENT_OCID"
project_prefix    = "sqlfw-demo"

# Paste contents of ~/.ssh/id_ed25519_sqlfw.pub
ssh_public_key    = "ssh-ed25519 AAAA... your-key"

# Restrict to your office / VPN CIDR in production; 0.0.0.0/0 opens SSH + app ports globally
# Changing this requires: DB stack Plan → Apply (Variables alone is not enough)
allow_ssh_cidr    = "0.0.0.0/0"

# Look up the 26.x version available in YOUR region:
#   oci db version list --compartment-id "$COMPARTMENT_ID" --region "$OCI_REGION" --all --output json \
#     | jq -r '.data[].version | select(test("^26\\."))' | sort -V
db_home_version   = "26.0.0.0.0"

# Set your own OCI-compliant passwords (do not reuse published demo values).
# Rules: 9+ chars, 2 upper, 2 lower, 2 digit, 2 of _ - #; must NOT contain "Oracle" or "sys".
# Omit these lines to use demo-only defaults from variables.tf (local workshops only).
# sys_password      = "CHANGE_ME_SysAdm12_Xy"
# app_db_password   = "CHANGE_ME_AppDb34_Gh"

pdb_name          = "SQLFWPDB1"
