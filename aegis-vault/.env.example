DB_USER=AEGIS_APP
DB_PASSWORD="OracleFWDemo-123#"
DB_CONNECTION_STRING=host:1521/ahdb2605_pdb1.service.name
DB_CONTAINER=AHDB2605_PDB1
PORT=3000
POLL_INTERVAL_MS=3000
# LuminaForge base URL for init-default-policy HTTP training (session context capture)
LUMINAFORGE_BASE_URL=http://localhost:3001
# Destructive demo reset is fail-closed unless all values are explicit.
# OCI cloud-init / scripts/ensure-demo-seed-env.sh enable these on demo VMs.
DEMO_SEED_RESET_ENABLED=false
DEMO_ENVIRONMENT=demo
DEMO_SEED_SCHEMA=LUMINAFORGE
# Generate at deployment; minimum 32 characters. Never commit the real value.
BREAK_GLASS_GRANT_SECRET=replace-with-a-random-secret-at-deploy-time
# Optional. Default follows the request scheme (HTTP demo cookies are not Secure).
# AEGIS_COOKIE_SECURE=false
